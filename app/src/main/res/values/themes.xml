<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DocCheck" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/ink_inverse</item>
        <item name="colorSecondary">@color/accent_mint</item>
        <item name="colorOnSecondary">@color/ink_on_accent</item>
        <item name="colorTertiary">@color/accent_pink</item>
        <item name="colorError">@color/error_pink</item>
        <item name="android:colorBackground">@color/bg_lavender</item>
        <item name="colorSurface">@color/glass_card_solid</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.DocCheck.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.DocCheck.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.DocCheck.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="Widget.DocCheck.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/glass_card_solid</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DocCheck.TopRounded</item>
    </style>

    <style name="ShapeAppearance.DocCheck.TopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_card_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_card_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
