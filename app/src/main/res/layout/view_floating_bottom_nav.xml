<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/bottom_nav_height"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Frosted backdrop layer (RenderEffect blur applied on Android 12+) -->
    <View
        android:id="@+id/navBlurBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_floating_nav" />

    <LinearLayout
        android:id="@+id/navContainer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/bg_floating_nav"
        android:elevation="@dimen/elevation_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_black"
            android:contentDescription="@string/nav_home"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home"
                app:tint="@color/nav_active_content" />

            <TextView
                android:id="@+id/labelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/nav_home"
                android:textColor="@color/nav_active_content"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Chat -->
        <LinearLayout
            android:id="@+id/tabChat"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/nav_chat"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/iconChat"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chat"
                app:tint="@color/ink" />

            <TextView
                android:id="@+id/labelChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/nav_chat"
                android:textColor="@color/nav_active_content"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/nav_history"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/iconHistory"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_history"
                app:tint="@color/ink" />

            <TextView
                android:id="@+id/labelHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/nav_history"
                android:textColor="@color/nav_active_content"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/nav_settings"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/iconSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings"
                app:tint="@color/ink" />

            <TextView
                android:id="@+id/labelSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/nav_settings"
                android:textColor="@color/nav_active_content"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>

