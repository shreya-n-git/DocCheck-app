<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lavender_gradient"
    android:clipChildren="false">

    <!-- Floating 3D Sphere Art in Top Half -->
    <ImageView
        android:id="@+id/ivWelcomeArt"
        android:layout_width="420dp"
        android:layout_height="350dp"
        android:layout_marginTop="-24dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/art_spheres"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo Tile + Wordmark -->
    <LinearLayout
        android:id="@+id/logoRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="@dimen/logo_tile_small"
            android:layout_height="@dimen/logo_tile_small"
            android:background="@drawable/bg_glass_logo_tile">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/ic_shield" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Skip Button -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:minHeight="@dimen/touch_target_min"
        android:minWidth="@dimen/touch_target_min"
        android:paddingHorizontal="12dp"
        android:text="@string/welcome_skip"
        android:textColor="@color/ink"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/logoRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/logoRow" />

    <!-- Bottom Content Area -->
    <LinearLayout
        android:id="@+id/welcomeContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvWelcomeTitle"
            style="@style/TextAppearance.DocCheck.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title" />

        <TextView
            android:id="@+id/tvWelcomeDesc"
            style="@style/TextAppearance.DocCheck.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/welcome_description"
            android:textColor="@color/muted" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/welcomePager"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <!-- Get Started Black Pill CTA with Arrow Circle -->
        <FrameLayout
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="@dimen/primary_btn_height"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_pill_black"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif"
                android:text="@string/welcome_get_started"
                android:textColor="@color/ink_inverse"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_glass_circle">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_up_right"
                    app:tint="@color/ink_inverse" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/btnAlreadyAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:paddingHorizontal="16dp"
            android:text="@string/welcome_existing_account"
            android:textColor="@color/ink"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

