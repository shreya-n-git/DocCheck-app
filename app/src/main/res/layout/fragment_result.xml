<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lavender_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/resultContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:clickable="true"
                android:contentDescription="@string/cd_back"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="@dimen/icon_btn_size"
                    android:layout_height="@dimen/icon_btn_size"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_glass_circle">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/ink" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                style="@style/TextAppearance.DocCheck.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/result_title" />
        </LinearLayout>

        <!-- Image & Tamper Gauge Glass Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.DocCheck.GlassCardLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDocumentPreview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:contentDescription="@string/cd_scanned_doc"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/pbTamperScore"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:layout_gravity="center"
                            android:max="100"
                            app:indicatorColor="@color/accent_pink"
                            app:indicatorSize="68dp"
                            app:trackColor="@color/glass_stroke"
                            app:trackThickness="6dp" />

                        <TextView
                            android:id="@+id/tvTamperScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/ink"
                            android:textSize="17sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.DocCheck.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/result_tamper_prob" />

                        <TextView
                            android:id="@+id/tvVerdictBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_glass_pill"
                            android:fontFamily="sans-serif"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/ink_on_accent"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.DocCheck.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/result_findings_header"
            android:textSize="20sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFindings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAskAi"
            style="@style/Widget.DocCheck.PrimaryPillButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/result_ask_ai"
            app:icon="@drawable/ic_sparkles"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

