<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/routerFragment">

    <fragment
        android:id="@+id/routerFragment"
        android:name="com.doccheck.app.ui.splash.RouterFragment"
        android:label="Router"
        tools:layout="@layout/fragment_router">
        <action
            android:id="@+id/action_router_to_welcome"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/routerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_router_to_auth"
            app:destination="@id/authFragment"
            app:popUpTo="@id/routerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_router_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/routerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.doccheck.app.ui.welcome.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcome_to_auth"
            app:destination="@id/authFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_enter"
            app:popExitAnim="@anim/nav_exit" />
    </fragment>

    <fragment
        android:id="@+id/authFragment"
        android:name="com.doccheck.app.ui.auth.AuthFragment"
        android:label="Auth"
        tools:layout="@layout/fragment_auth">
        <argument
            android:name="startTab"
            android:defaultValue="0"
            app:argType="integer" />
        <action
            android:id="@+id/action_auth_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.doccheck.app.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_result"
            app:destination="@id/resultFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_enter"
            app:popExitAnim="@anim/nav_exit" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.doccheck.app.ui.home.ResultFragment"
        android:label="Result"
        tools:layout="@layout/fragment_result">
        <argument
            android:name="scanId"
            app:argType="string" />
        <action
            android:id="@+id/action_result_to_chat"
            app:destination="@id/chatFragment"
            app:enterAnim="@anim/slide_up_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_enter"
            app:popExitAnim="@anim/slide_down_exit" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.doccheck.app.ui.chat.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="scanContext"
            android:defaultValue="@null"
            app:argType="com.doccheck.app.data.model.ScanResult"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.doccheck.app.ui.history.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_history_to_result"
            app:destination="@id/resultFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_enter"
            app:popExitAnim="@anim/nav_exit" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.doccheck.app.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_auth"
            app:destination="@id/authFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>

